__pycache__/
.venv/
*.pyc
.DS_Store
*.log
.pytest_cache/
build/
dist/
*.egg-info/
site/

# Coverage artefacts (uploaded from CI, never committed)
.coverage
.coverage.*
coverage.xml

# Explicit XLA compilation cache location used by CI
.xla-cache/

# Working notes and the write-up: process artifacts, not part of the package
docs/superpowers/

# The writeup is tracked -- source, figures and the built PDF -- but its build artefacts,
# rasterised previews and cached sweeps are not.
docs/writeup/*.aux
docs/writeup/*.fdb_latexmk
docs/writeup/*.fls
docs/writeup/*.log
docs/writeup/*.out
docs/writeup/*.png
docs/writeup/cache_*.npy
